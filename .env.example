# Copy to .env.local. Every value is optional: without them the prototype runs in demo mode.

# AI requirement summaries (Claude API); without a key a local summarizer is used
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Developer dashboard login; without a password the dashboard is open (demo mode)
DASHBOARD_PASSWORD=
SESSION_SECRET=

# Real email delivery by SMTP; without SMTP_HOST messages are only logged in the Outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Nordiso <hello@your-domain.fi>"
MAIL_FROM_ADDRESS=hello@your-domain.fi

# Shared secret for the scheduler endpoint GET /api/automation/run (cron job)
CRON_SECRET=
