{
  "name": "nordiso-intake-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Automated client intake, quotation and onboarding for Nordiso (IU DLBCCOEDAH01, final version)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "seed": "tsx scripts/seed.ts",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "coverage": "vitest run --coverage --coverage.include='src/lib/**' --coverage.reporter=text"
  },
  "dependencies": {
    "next": "16.4.2",
    "nodemailer": "7.0.13",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "5.0.5"
  }
}
